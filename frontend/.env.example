# Leave EMPTY for local development and for the one-server deployment: the app then talks to the
# server it was loaded from ("/api"; in dev Vite proxies it to http://localhost:4000).
#
# Only the Android app and the GitHub Pages copy need an address, and GitHub Actions supplies it
# from the repository variable API_URL — you don't edit this file for those.
VITE_API_URL=

# Show the demo login hint on the sign-in page (development only)
# VITE_SHOW_DEMO=true
