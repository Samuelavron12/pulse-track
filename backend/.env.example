# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Local:  postgresql://postgres:YOUR_PASSWORD@localhost:5432/pulse_track
# Hosted (Neon / Supabase / Render): paste the connection string they give you.
# If your password contains @ # / ? : URL-encode it (@ → %40, # → %23).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/pulse_track
# true/false. Leave empty = automatic (SSL on for hosted databases in production).
DATABASE_SSL=

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_96_CHAR_HEX_SECRET
JWT_EXPIRES_IN=30d

# ── Master admin (web page at  /admin ) ─────────────────────────────────────
# Sign-in for the master admin page. Created on first start.
# If you leave both empty, a random password is generated and printed ONCE in the server log.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Forgot the admin password? Set your new ADMIN_PASSWORD, add ADMIN_RESET_PASSWORD=true,
# restart once, then remove ADMIN_RESET_PASSWORD.
# ADMIN_RESET_PASSWORD=true

# ── Optional ────────────────────────────────────────────────────────────────
# Fill the database with a demo business (demo@pulsetrack.app / demo1234) on start. Off for real use.
# SEED_DEMO=true
# Restrict which websites may call the API (comma-separated). Empty = allow all (safe: the app
# uses Bearer tokens, not cookies). The Android app always needs https://localhost allowed.
# CORS_ORIGIN=https://you.github.io,https://localhost,capacitor://localhost
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000
